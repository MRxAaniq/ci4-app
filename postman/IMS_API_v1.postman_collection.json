{
  "info": {
    "name": "IMS API (v1) - Multi-Branch Inventory & Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman test cases for the CodeIgniter 4 Inventory & Order Management System.\n\nAuth model: session cookie (login establishes a server session). Run folders in order using Collection Runner.\n\nBase URL: {{baseUrl}}"
  },
  "item": [
    {
      "name": "0. Pre-auth",
      "item": [
        {
          "name": "GET Branches (Unauthorized)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Body has message Unauthorized', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('message');",
                  "  pm.expect(json.message).to.eql('Unauthorized');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Happy path (Admin)",
      "item": [
        {
          "name": "POST Auth Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response envelope has data.user', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.have.property('user');",
                  "  pm.expect(json.data.user).to.have.property('role');",
                  "});",
                  "pm.test('Session cookie set (best-effort)', function () {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie');",
                  "  pm.expect(setCookie || '').to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Branches Create (Branch A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Branch A (Postman)\",\n  \"address\": \"Address A\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const id = json?.data?.branch?.id;",
                  "pm.test('Branch id returned', function () { pm.expect(id).to.be.a('number'); });",
                  "pm.environment.set('branchAId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Branches Create (Branch B)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Branch B (Postman)\",\n  \"address\": \"Address B\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const id = json?.data?.branch?.id;",
                  "pm.test('Branch id returned', function () { pm.expect(id).to.be.a('number'); });",
                  "pm.environment.set('branchBId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Branches Update (Branch A)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Address A (Updated)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches/{{branchAId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Branch A id is set', function () { pm.expect(pm.environment.get('branchAId')).to.not.eql(''); });",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Branches Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('branches[] exists', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.branches).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Products Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Product (Postman)\",\n  \"sku\": \"P-POSTMAN-{{$timestamp}}\",\n  \"cost_price\": 10.00,\n  \"sale_price\": 25.00,\n  \"tax_percentage\": 15.00,\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const id = json?.data?.product?.id;",
                  "pm.test('Product id returned', function () { pm.expect(id).to.be.a('number'); });",
                  "pm.environment.set('productId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Products Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('products[] exists', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.products).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Products Update",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale_price\": 30.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product id is set', function () { pm.expect(pm.environment.get('productId')).to.not.eql(''); });",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Inventory Add Stock (Branch A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 10,\n  \"note\": \"Postman add stock\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches/{{branchAId}}/inventory/add"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Branch A and productId are set', function () {",
                  "  pm.expect(pm.environment.get('branchAId')).to.not.eql('');",
                  "  pm.expect(pm.environment.get('productId')).to.not.eql('');",
                  "});",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Inventory Adjust Stock (Branch A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"delta\": -2,\n  \"note\": \"Postman adjust stock\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches/{{branchAId}}/inventory/adjust"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Inventory (Branch A)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/branches/{{branchAId}}/inventory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('inventory[] exists', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.inventory).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Inventory Product (Branch A / Product)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/branches/{{branchAId}}/inventory/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('quantity is a number', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.quantity).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Orders Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": {{branchAId}},\n  \"products\": [\n    {\"product_id\": {{productId}}, \"quantity\": 2}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "const orderId = json?.data?.order?.id;",
                  "pm.test('Order is submitted', function () { pm.expect(json?.data?.order?.status).to.eql('SUBMITTED'); });",
                  "pm.environment.set('orderId', String(orderId || ''));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Transfers Create (A -> B)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_branch\": {{branchAId}},\n  \"to_branch\": {{branchBId}},\n  \"product_id\": {{productId}},\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Transfer status is RECEIVED', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.transfer?.status).to.eql('RECEIVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Products Delete (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Auth Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Negative & RBAC",
      "item": [
        {
          "name": "POST Auth Login (Sales)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"{{salesPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Role is SALES', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json?.data?.user?.role).to.eql('SALES');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Branches Create (Forbidden for Sales)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\",\n  \"address\": \"x\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', function () { pm.response.to.have.status(403); });",
                  "pm.test('Body has message Forbidden', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.eql('Forbidden');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Inventory Add (Forbidden for Sales)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/branches/{{salesBranchId}}/inventory/add"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Orders Create (Invalid products shape -> 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": 1,\n  \"products\": \"not-an-array\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
