# Test environment overrides (used when ENVIRONMENT=testing)

# Use a dedicated test database (DO NOT point at production/dev DB)
database.tests.hostname = 127.0.0.1
database.tests.database = ims_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver  = MySQLi
database.tests.DBPrefix  =

# Optional: if running behind Docker, change hostname accordingly
# database.tests.hostname = mysql
